# ==============================================================================
# Portfolio Mail Backend Environment Variables (.env)
# ==============================================================================
# Add these variables to your Vercel Dashboard:
# Project Settings -> Environment Variables
# Or use them locally in your root .env file
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Nodemailer with Gmail (Recommended if using Google App Password)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password_without_spaces

# Destination email where incoming portfolio messages will be received
EMAIL_RECEIVER=your_destination_email@gmail.com


# ------------------------------------------------------------------------------
# OPTION 2: Resend (Alternative - No Google App Password needed)
# ------------------------------------------------------------------------------
# Get your free API key at https://resend.com
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_1234567890abcdef
